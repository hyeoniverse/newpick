# ---- 필수 ----
# 서로 다른 긴 임의 문자열 (예: openssl rand -base64 48)
JWT_SECRET=
JWT_REFRESH_SECRET=
# 프론트 주소. CORS 허용과 로그인 후 리디렉션에 사용
FRONTEND_URL=http://localhost:3000
# 메일 원클릭 수신 거부 링크 서명 (#18, 선택). 비우면 JWT_SECRET에서 만든 값. 바꾸면 이미 보낸 메일의 링크가 무효
UNSUBSCRIBE_SECRET=
# 사이트 캐시 비우기 (#73, 선택). 웹(Vercel)의 REVALIDATE_SECRET과 같은 값. 없으면 캐시를 비우지 않고 10분 뒤 저절로 바뀜
REVALIDATE_SECRET=

# ---- DB (docker compose로 띄우면 compose가 덮어씀) ----
MYSQL_URL=mysql://root:root@localhost:3308/newpick
MONGO_URL=mongodb://localhost:27018/newpick

# ---- 로그인 (Google OAuth) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 프론트의 /api 프록시를 거치게 해야 로그인 쿠키가 프론트 도메인에 저장됩니다.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ---- AI 요약 (Claude) ----
ANTHROPIC_API_KEY=
# 선택. 뉴스레터 쓰기 모델, 기본 claude-sonnet-5-5. 더 아끼려면 claude-haiku-5-5
CLAUDE_MODEL=
# 기사 고르기처럼 가벼운 작업용 (기본 claude-haiku-5-5)
CLAUDE_FAST_MODEL=

# ---- 오픈 모델 (선택, #119) ----
# Cloudflare Workers AI. 대시보드 > API Tokens > 'Workers AI' 템플릿으로 만든 토큰과 계정 ID.
# 없으면 오픈 모델 없이 Claude만 쓴다. 무료 요금제는 하루 10,000 neurons, 넘으면 요금 없이 거절
CF_ACCOUNT_ID=
CF_AI_TOKEN=
# 선택. 기본 @cf/google/gemma-4-26b-a4b-it · @cf/baai/bge-m3
AI_OPEN_MODEL=
AI_EMBED_MODEL=
# 오픈 모델이 안 될 때 Claude(빠른 모델)로 넘기는 비용의 하루 상한 (USD, 기본 0.1)
AI_FALLBACK_DAILY_USD=

# ---- 뉴스레터 사진 (선택) ----
# 원출처 사진이 없는 소식에 쓸 사진 검색. 없으면 그 단계만 건너뜁니다
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# ---- 메일 (Gmail 앱 비밀번호) ----
MAIL_USER=
MAIL_PASSWORD=

# ---- 선택 ----
PORT=3001
# 서브도메인으로 나눠 배포할 때만 (예: .example.com)
COOKIE_DOMAIN=
# lax(기본, 프론트 프록시를 거치는 구성) | none(프론트와 api를 다른 사이트에서 직접 호출할 때)
COOKIE_SAMESITE=lax
# AI 요약 결과를 받을 운영자 메일
ADMIN_NOTIFY_EMAIL=
# 비우면 Sentry 없이 실행
SENTRY_DSN=

# 예약 작업(수집 · AI 요약 · 메일)을 예약 시각에 저절로 돌릴지. 비우면 돌린다(운영).
# 로컬은 false로 두고 관리자 화면 '지금 실행'만 쓴다 (운영과 따로 Claude를 부르고 로컬 구독자에게 실제 메일을 보내지 않게)
SCHEDULER_ENABLED=
