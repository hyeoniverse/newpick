generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("MYSQL_URL")
}

// User 모델
model User {
  id                      Int      @id @default(autoincrement())
  email                   String   @unique
  /// Google 계정 고유 ID. 로그인은 이것으로 찾는다 (이메일을 바꿔도 같은 계정). 예전 사용자는 다음 로그인 때 채운다
  googleSub               String?  @unique @db.VarChar(64)
  username                String?
  profileImg              String?
  timezone                String   @default("UTC")
  frequency               String   @default("weekly") // 발송 주기
  role                    String   @default("user")
  notificationPreferences Json?
  /// 맞춤 메일 (#123): 끄면 북마크 · 스크랩으로 고르지 않고 구독한 분야의 뉴스레터를 분야별로 받는다
  personalMail            Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  bookmarks   Bookmark[]
  highlights  Highlight[]
  follows     StoryFollow[]
  folders     Folder[]
  mailMarks   MailMark[]
  interests   UserInterest[]
  oAuthTokens OAuthToken[]
  subscribers Subscriber[]
  emailChange EmailChange?

  @@map("users")
}

// Subscriber 모델
model Subscriber {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique // 사용자별 중복 구독 방지
  startedAt DateTime  @default(now())
  endAt     DateTime?
  status    String    @default("active") // 상태 : active, paused, cancelled

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscribers")
}

// OAuthToken 모델
/// 로그인 세션: 기기(브라우저)마다 한 줄 (마이페이지에서 보고 따로 로그아웃). refresh token은 원문 대신 SHA-256만 둔다.
/// 갱신할 때마다 새 토큰으로 바꾸고(rotation) 만료를 미룬다. 바로 전 토큰도 잠깐(동시에 갱신한 다른 탭) 받는다
model OAuthToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  tokenHash  String    @unique @db.Char(64)
  prevHash   String?   @db.Char(64)
  rotatedAt  DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  /// 로그인한 브라우저 (마이페이지 '로그인한 기기'에 보여 줌)
  userAgent  String?   @db.VarChar(255)
  /// 마지막으로 토큰을 갱신한 때 (access token이 3시간이라 그 정도 단위)
  lastUsedAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([prevHash])
  @@map("oauth_tokens")
}

/// 이메일 바꾸기 진행 중: 새 주소로 보낸 인증 코드 (사용자마다 하나, 코드는 SHA-256만)
model EmailChange {
  userId    Int      @id
  newEmail  String
  codeHash  String   @db.Char(64)
  attempts  Int      @default(0)
  sentAt    DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_changes")
}

// Newsletter 모델
model Newsletter {
  id            Int      @id @default(autoincrement())
  title         String
  /// 제목에 담지 않은 나머지 주요 소식 한 줄 (#42). 이전 뉴스레터는 null
  subtitle      String?
  /// 키워드 3~6개, 문자열 배열 (#50). 이전 뉴스레터는 null
  keywords      Json?
  content       String   @db.LongText
  contentAsHTML String?  @db.LongText
  imageUrl      String?  @db.LongText
  categoryId    Int
  viewcount     Int      @default(0)
  usedNews      String   @db.LongText
  createdAt     DateTime @default(now())

  category   NewsCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  bookmarks  Bookmark[]
  highlights Highlight[]
  archives   EmailArchive[]
  follows    StoryFollow[]
  followUps  FollowUpdate[]

  /// 지난 뉴스레터 검색 (#20). 실제 인덱스는 한국어를 2글자씩 나누는 ngram 파서로 만든다(마이그레이션 SQL)
  @@fulltext([title, subtitle, content], map: "newsletters_search_idx")
  @@map("newsletters")
}

// NewsCategory 모델
model NewsCategory {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String? @db.Text

  newsletters     Newsletter[]
  interestedUsers UserInterest[]

  @@map("news_categories")
}

// 사용자 관심 카테고리 (구독 메일에 포함할 카테고리)
model UserInterest {
  userId     Int
  categoryId Int
  createdAt  DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category NewsCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@map("user_interests")
}

// EmailArchive 모델
model EmailArchive {
  id           Int      @id @default(autoincrement())
  newsletterId Int
  sentAt       DateTime
  email        String

  newsletter Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)

  @@map("email_archives")
}

/// 맞춤 메일 계획 (#123 3단계): 한 통에서 취향으로 앞당긴 소식 · 더한 다른 분야 소식.
/// 마이페이지에서 받은 그대로 다시 만들 때 쓴다. 맞춤이 없던 메일은 없다
model MailPlan {
  id     Int      @id @default(autoincrement())
  email  String
  sentAt DateTime
  plan   Json

  @@unique([email, sentAt])
  @@map("mail_plans")
}

// AiProcessLog 모델
model AiProcessLog {
  id           Int      @id @default(autoincrement())
  newsId       String   @db.Text
  processType  String
  result       String   @db.Text
  duration     Float
  createdAt    DateTime @default(now())
  status       String
  error        String?  @db.Text
  token        Int
  /// 쓴 모델 (여럿이면 쉼표로). 이전 기록은 null
  model        String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  /// 이 처리에 든 Claude 비용 (USD). 모르는 모델이거나 이전 기록이면 null
  costUsd      Float?
  /// 호출별 사용량 (#122): [{ stage, model, input, output, costUsd }]. stage는 select(고르기) · write(쓰기) · category · edition.
  /// 이전 기록은 null (합계만 있음)
  calls        Json?

  @@map("ai_process_logs")
}

// Bookmark 모델: 사용자가 저장한 뉴스레터
model Bookmark {
  id           Int      @id @default(autoincrement())
  userId       Int
  newsletterId Int
  createdAt    DateTime @default(now())
  /// 폴더 (#123, 스크랩 · 받은 메일과 같은 폴더). 폴더를 지우면 null
  folderId     Int?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  newsletter Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  folder     Folder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([userId, newsletterId])
  @@index([folderId])
  @@map("bookmarks")
}

// ScheduleConfig 모델
model ScheduleConfig {
  id            Int      @id @default(autoincrement())
  /// 구독 메일: hour시 mailMinute분, day 0(일)~6(토) · 7(매일) (#55)
  hour          Int      @default(8)
  day           Int      @default(7)
  mailMinute    Int      @default(40)
  /// 기사 수집 · AI 요약 시각 (#21, 관리자 화면에서 바꾼다)
  crawlHour     Int      @default(8)
  crawlMinute   Int      @default(0)
  summaryHour   Int      @default(8)
  summaryMinute Int      @default(30)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("schedule_configs")
}

/// 하루 한 번 전 분야 소식을 편집한 결과 (#55). 구독 메일은 이것으로 구독자마다 엮는다
model DailyEdition {
  id            Int      @id @default(autoincrement())
  /// KST 날짜 'YYYY-MM-DD'
  date          String   @unique @db.VarChar(10)
  /// 편집에 쓴 뉴스레터 id 목록
  newsletterIds Json
  /// 중요도·같은 사건·분야를 넘는 흐름 (edition/editor.ts Editorial). 편집 호출이 실패하면 null
  editorial     Json?
  token         Int      @default(0)
  createdAt     DateTime @default(now())

  @@map("daily_editions")
}

/// 예약 작업 실행 기록 (#21). 수집 · AI 요약 · 구독 메일이 언제 어떻게 돌았는지
model JobRun {
  id         Int       @id @default(autoincrement())
  /// crawling · summary · mail
  job        String    @db.VarChar(20)
  /// schedule(예약) · manual(관리자가 지금 실행)
  trigger    String    @default("schedule") @db.VarChar(20)
  /// running · success · partial · failed · skipped
  status     String    @db.VarChar(20)
  message    String?   @db.Text
  startedAt  DateTime
  finishedAt DateTime?
  durationMs Int?

  @@index([startedAt])
  @@index([job, startedAt])
  @@map("job_runs")
}

/// 태그 규칙 (#20 태그 정돈). alias: 이 태그를 target으로 바꿔 쓴다 (합치기), block: 이 태그는 쓰지 않는다 (지우기).
/// 관리자가 합치기 · 지우기를 하면 생기고, 새 뉴스레터를 저장할 때 적용된다
model TagRule {
  id        Int      @id @default(autoincrement())
  /// 규칙이 걸리는 태그 (표기 그대로)
  keyword   String   @unique @db.VarChar(100)
  action    String   @db.VarChar(10)
  target    String?  @db.VarChar(100)
  createdAt DateTime @default(now())

  @@map("tag_rules")
}

/// 구독 기록 (#122 통계). subscribers는 회원당 한 줄이라 다시 구독하면 덮어써서, 언제 들어오고 나갔는지는 여기에 쌓는다.
/// 회원을 지워도 통계가 바뀌지 않게 users와 묶지 않는다(userId만)
model SubscriptionEvent {
  id         Int      @id @default(autoincrement())
  userId     Int
  /// subscribe · pause · resume · cancel
  type       String   @db.VarChar(10)
  /// 그때의 관심사 id 목록
  interests  Json?
  at         DateTime @default(now())
  /// 마이그레이션에서 지금 구독 상태로 채운 줄 (기록 시작 전 추정)
  backfilled Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([at])
  @@index([userId])
  @@map("subscription_events")
}

/// 방문 통계 (#131): 페이지 한 번 보기 = 한 줄. 쿠키 · IP · 계정과 연결하지 않고, 탭마다 임시 번호만.
/// 브라우저가 누적 값을 여러 번 보내 덮어쓴다. 180일 지나면 지운다
model PageView {
  /// 브라우저가 만든 이 보기의 번호
  id           String   @id @db.VarChar(32)
  /// 탭마다 임시 번호 (sessionStorage, 탭을 닫으면 사라짐)
  sessionId    String   @db.VarChar(32)
  path         String   @db.VarChar(255)
  /// 같은 화면끼리 묶은 경로 (/articles/detail/:id)
  route        String   @db.VarChar(120)
  /// 이 탭의 첫 페이지
  entry        Boolean  @default(false)
  /// direct · search · social · email · referral · internal
  channel      String   @db.VarChar(20)
  /// 이전 사이트의 호스트만 (전체 주소는 남기지 않음)
  referrerHost String?  @db.VarChar(120)
  utmSource    String?  @db.VarChar(100)
  utmMedium    String?  @db.VarChar(100)
  utmCampaign  String?  @db.VarChar(100)
  /// mobile · tablet · desktop
  device       String   @db.VarChar(10)
  viewportW    Int
  /// 탭이 보이고 움직임이 있던 시간
  durationMs   Int      @default(0)
  /// 본 가장 아래 (문서 높이 대비 %)
  scrollDepth  Int      @default(0)
  /// 구역마다 화면에 보인 시간 { 이름: ms }
  sections     Json?
  /// 문서를 20칸으로 나눠 칸마다 화면에 보인 시간 (ms)
  attention    Json?
  /// 클릭 [가로 비율, 세로 비율, 구역] (100개까지)
  clicks       Json?
  startedAt    DateTime
  updatedAt    DateTime @updatedAt

  @@index([startedAt])
  @@index([route, startedAt])
  @@map("page_views")
}

/// 스크랩 · 메모 (#123 1단계): 뉴스레터 본문에서 고른 문장, 메모는 선택.
/// 회원 · 뉴스레터를 지우면 함께 지워진다. 같은 사람이 같은 뉴스레터의 같은 문장을 두 번 저장하지 않는다
model Highlight {
  id           Int      @id @default(autoincrement())
  userId       Int
  newsletterId Int
  /// 본문의 어느 구역인지 (briefing · story-1 …). 다시 형광펜을 칠할 때 그 구역 안에서 찾는다
  section      String?  @db.VarChar(40)
  /// 그 소식(story-N)의 제목. 스크랩할 때 한 번 본문에서 꺼내 둔다 (목록마다 본문을 읽지 않게).
  /// null = 아직 안 꺼냄(예전 스크랩 · 본문을 고친 뒤), '' = 제목 없는 구역(브리핑 등)
  sectionTitle String?  @db.VarChar(200)
  /// 고른 문장 (500자까지)
  text         String   @db.VarChar(500)
  note         String?  @db.Text
  /// 별표(중요). 지울 때 한 번 더 확인하고, 취향 점수에 더 얹는다
  starred      Boolean  @default(false)
  /// 폴더. 폴더를 지우면 '폴더 없음'(null)으로
  folderId     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  newsletter Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  folder     Folder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([userId, newsletterId, text])
  @@index([folderId])
  @@index([userId, createdAt])
  @@map("highlights")
}

/// 폴더 (#123): 스크랩 · 북마크 · 받은 메일이 같이 쓰는 주제 폴더. 사람마다 이름이 겹치지 않게.
/// 지우면 안의 것은 지우지 않고 '폴더 없음'으로
model Folder {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String   @db.VarChar(30)
  createdAt DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  highlights Highlight[]
  bookmarks  Bookmark[]
  mailMarks  MailMark[]

  @@unique([userId, name])
  @@map("folders")
}

/// 받은 메일 표시 (#123): 받은 메일 한 통(보낸 시각)마다 중요 표시 · 폴더. 표시한 메일만 줄이 생긴다
model MailMark {
  id        Int      @id @default(autoincrement())
  userId    Int
  /// 받은 메일의 보낸 시각 (email_archives.sentAt과 같은 값)
  sentAt    DateTime
  starred   Boolean  @default(false)
  folderId  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([userId, sentAt])
  @@index([folderId])
  @@map("mail_marks")
}

/// 후속 지켜보기: 사용자가 뉴스레터 속 소식 하나를 지켜본다. 이어지는 새 소식이 나오면 follow_updates에 쌓인다.
/// 판정용으로 그 소식의 제목 · 글을 그때 그대로 남긴다 (뉴스레터가 고쳐져도 지켜본 내용 기준)
model StoryFollow {
  id           Int      @id @default(autoincrement())
  userId       Int
  newsletterId Int
  /// 뉴스레터 안 소식 순서 (1부터)
  storyIndex   Int
  heading      String   @db.VarChar(200)
  text         String   @db.Text
  /// 판정용 임베딩 (bge-m3). 처음 판정할 때 한 번 계산해 둔다
  embedding    Json?
  createdAt    DateTime @default(now())

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  newsletter Newsletter     @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  updates    FollowUpdate[]

  @@unique([userId, newsletterId, storyIndex])
  @@index([newsletterId])
  @@map("story_follows")
}

/// 지켜보는 소식에 이어진 새 소식 (하루 한 번 판정)
model FollowUpdate {
  id           Int       @id @default(autoincrement())
  followId     Int
  newsletterId Int
  storyIndex   Int
  heading      String    @db.VarChar(200)
  /// 어떻게 이어지는지 한 줄 (판정 모델이 쓴 것, 없으면 빈 문자열)
  reason       String    @db.VarChar(300)
  createdAt    DateTime  @default(now())
  /// 사용자가 봤는지 (머리글 표시 · 마이페이지 '새 소식')
  seenAt       DateTime?

  follow     StoryFollow @relation(fields: [followId], references: [id], onDelete: Cascade)
  newsletter Newsletter  @relation(fields: [newsletterId], references: [id], onDelete: Cascade)

  @@unique([followId, newsletterId, storyIndex])
  @@map("follow_updates")
}
