generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("MYSQL_URL")
}

// User 모델
model User {
  id                      Int      @id @default(autoincrement())
  email                   String   @unique
  username                String?
  profileImg              String?
  timezone                String   @default("UTC")
  frequency               String   @default("weekly") // 발송 주기
  role                    String   @default("user")
  notificationPreferences Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  bookmarks   Bookmark[]
  interests   UserInterest[]
  oAuthTokens OAuthToken[]
  subscribers Subscriber[]

  @@map("users")
}

// Subscriber 모델
model Subscriber {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique // 사용자별 중복 구독 방지
  startedAt DateTime  @default(now())
  endAt     DateTime?
  status    String    @default("active") // 상태 : active, paused, cancelled

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscribers")
}

// OAuthToken 모델
model OAuthToken {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  refreshToken String   @db.Text
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("oauth_tokens")
}

// Newsletter 모델
model Newsletter {
  id            Int      @id @default(autoincrement())
  title         String
  /// 제목에 담지 않은 나머지 주요 소식 한 줄 (#42). 이전 뉴스레터는 null
  subtitle      String?
  /// 키워드 3~6개, 문자열 배열 (#50). 이전 뉴스레터는 null
  keywords      Json?
  content       String   @db.LongText
  contentAsHTML String?  @db.LongText
  imageUrl      String?  @db.LongText
  categoryId    Int
  viewcount     Int      @default(0)
  usedNews      String   @db.LongText
  createdAt     DateTime @default(now())

  category  NewsCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  bookmarks Bookmark[]
  archives  EmailArchive[]

  /// 지난 뉴스레터 검색 (#20). 실제 인덱스는 한국어를 2글자씩 나누는 ngram 파서로 만든다(마이그레이션 SQL)
  @@fulltext([title, subtitle, content], map: "newsletters_search_idx")
  @@map("newsletters")
}

// NewsCategory 모델
model NewsCategory {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String? @db.Text

  newsletters     Newsletter[]
  interestedUsers UserInterest[]

  @@map("news_categories")
}

// 사용자 관심 카테고리 (구독 메일에 포함할 카테고리)
model UserInterest {
  userId     Int
  categoryId Int
  createdAt  DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category NewsCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@map("user_interests")
}

// EmailArchive 모델
model EmailArchive {
  id           Int      @id @default(autoincrement())
  newsletterId Int
  sentAt       DateTime
  email        String

  newsletter Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)

  @@map("email_archives")
}

// AiProcessLog 모델
model AiProcessLog {
  id          Int      @id @default(autoincrement())
  newsId      String   @db.Text
  processType String
  result      String   @db.Text
  duration    Float
  createdAt   DateTime @default(now())
  status      String
  error       String?  @db.Text
  token       Int

  @@map("ai_process_logs")
}

// Bookmark 모델: 사용자가 저장한 뉴스레터
model Bookmark {
  id           Int      @id @default(autoincrement())
  userId       Int
  newsletterId Int
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  newsletter Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)

  @@unique([userId, newsletterId])
  @@map("bookmarks")
}

// ScheduleConfig 모델
model ScheduleConfig {
  id        Int      @id @default(autoincrement())
  hour      Int      @default(8)
  day       Int      @default(7) // 0: 일요일 ~ 6: 토요일, 7: 매일 (#55)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("schedule_configs")
}

/// 하루 한 번 전 분야 소식을 편집한 결과 (#55). 구독 메일은 이것으로 구독자마다 엮는다
model DailyEdition {
  id            Int      @id @default(autoincrement())
  /// KST 날짜 'YYYY-MM-DD'
  date          String   @unique @db.VarChar(10)
  /// 편집에 쓴 뉴스레터 id 목록
  newsletterIds Json
  /// 중요도·같은 사건·분야를 넘는 흐름 (edition/editor.ts Editorial). 편집 호출이 실패하면 null
  editorial     Json?
  token         Int      @default(0)
  createdAt     DateTime @default(now())

  @@map("daily_editions")
}
